{
  "name": "@nenekusanagi/koishi-plugin-setu",
  "description": "A simple setu program powered by Koishi.",
  "version": "1.1.1",
  "contributors": [
    "NeneKusanagi <nenekusa.sekai@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chitsanfei/koishi-plugin-setu.git"
  },
  "koishi": {
    "description": {
      "en": "A simple setu plugin based on previous work",
      "zh": "基于前人做了小修改的好玩的图片插件\n（重生中，旧账号没法取回了 0v0 ）"
    },
    "locales": [
      "zh"
    ]
  },
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "koishi dev",
    "build": "tsc",
    "start": "koishi start",
    "test": "echo \"No tests yet\"",
    "pre-commit": "lint-staged",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "lint": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\""
  },
  "lint-staged": {
    "*.{ts,js}": [
      "prettier --write",
      "git add"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write",
      "git add"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin"
  ],
  "peerDependencies": {
    "koishi": "^4.12.2"
  },
  "engines": {
    "node": ">=16"
  }
}
